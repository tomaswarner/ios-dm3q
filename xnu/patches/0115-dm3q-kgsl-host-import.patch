+/* ---- host memory window ---- */
+extern pmap_t get_task_pmap(task_t);
+extern task_t current_task(void);
+extern ppnum_t pmap_find_phys(pmap_t, addr64_t);
+extern kern_return_t vm_map_wire_kernel(vm_map_t, vm_map_offset_t, vm_map_offset_t, vm_prot_t, vm_tag_t, boolean_t);
+extern kern_return_t vm_map_unwire(vm_map_t, vm_map_offset_t, vm_map_offset_t, boolean_t);
+
+static void
+gpu_tlb_flush(void)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr32(k.cb + 0x618, 0);                          /* CB_TLBIALL */
+	wr32(k.cb + 0x7f0, 0);                          /* CB_TLBSYNC */
+	for (int us = 0; us < 10000 && (rd32(k.cb + 0x7f4) & 1u); us++) {
+		delay(1);
+	}
+}
+
+/* a zeroed 4 KiB table from a pool page, mapped for the kernel; its pa in *pa */
+static vm_offset_t
+table_page(uint64_t *pa)
+{
+	int64_t p = pages_alloc(1, 1);
+	if (p < 0) {
+		return 0;
+	}
+	*pa = k.data_pa + (uint64_t)p * BO_PAGE;
+	vm_offset_t va = sweet_gpu_map(*pa, BO_PAGE);
+	if (va) {
+		for (unsigned i = 0; i < 512; i++) {
+			wr64(va + 8u * i, 0);
+		}
+	}
+	return va;
+}
+
+static int64_t
+host_slots_alloc(uint32_t n)
+{
+	for (uint32_t s = 0; s + n <= HOST_SLOTS; s++) {
+		uint32_t i;
+		for (i = 0; i < n && !((k.host_bitmap[(s + i) / 64] >> ((s + i) % 64)) & 1u); i++) {
+		}
+		if (i == n) {
+			for (i = 0; i < n; i++) {
+				k.host_bitmap[(s + i) / 64] |= 1ull << ((s + i) % 64);
+			}
+			return s;
+		}
+		s += i;
+	}
+	return -1;
+}
+
+/* write (or clear, pa == ~0) the 4 KiB PTE for host-window VA gva; false when no table */
+static bool
+host_pte(uint64_t gva, uint64_t pa)
+{
+	unsigned i2 = (unsigned)((gva - HOST_GPUVA) >> 21), i3 = (unsigned)((gva >> 12) & 0x1ff);
+	if (!k.host_l3[i2]) {
+		uint64_t tpa;
+		vm_offset_t t = table_page(&tpa);
+		if (!t) {
+			return false;
+		}
+		k.host_l3[i2] = t;
+		wr64(k.host_l2 + 8u * i2, tpa | 3u);
+	}
+	wr64(k.host_l3[i2] + 8u * i3, pa == ~0ull ? 0 : (pa | PTE_HOST));
+	return true;
+}
+
+static void
+host_unmap(struct kbo *b, uint64_t mapped)
+{
+	for (uint64_t o = 0; o < mapped; o += 0x1000) {
+		(void)host_pte(b->gva + o, ~0ull);
+	}
+	gpu_tlb_flush();
+	uint32_t s = (uint32_t)((b->gva - HOST_GPUVA) / 0x4000);
+	for (uint32_t i = 0; i < b->size / 0x4000; i++) {
+		k.host_bitmap[(s + i) / 64] &= ~(1ull << ((s + i) % 64));
+	}
+}
