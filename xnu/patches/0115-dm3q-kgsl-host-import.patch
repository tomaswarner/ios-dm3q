 static void
 bo_release(struct kbo *b)
 {
+	if (b->host) {
+		host_unmap(b, b->size);
+		(void)vm_map_unwire(b->map, (vm_map_offset_t)b->uaddr, (vm_map_offset_t)(b->uaddr + b->size), TRUE);
+		vm_map_deallocate(b->map);
+		bzero(b, sizeof(*b));
+		return;
+	}
 	pages_mark((uint32_t)((b->pa - k.data_pa) / BO_PAGE), (uint32_t)(b->size / BO_PAGE), false);
 	if (b->entry != IPC_PORT_NULL) {
 		mach_memory_entry_port_release(b->entry);
