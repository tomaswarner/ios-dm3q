+/* KGSL_IOS_IMPORT: the caller's [addr, addr + size), wired (user wiring: munmap still works and
+ * unwires; Vulkan forbids freeing imported host memory before the VkDeviceMemory) */
+static int
+bo_import(int owner, struct kgsl_ios_import *im)
+{
+	if ((im->addr | im->size) & 0x3fffu || !im->size || im->size > (256ull << 20)) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&kgsl_mtx);
+	int id = -1;
+	for (int i = 0; i < MAX_BO && id < 0; i++) {
+		if (!k.bo[i].used) {
+			id = i;
+		}
+	}
+	int64_t slot = id < 0 ? -1 : host_slots_alloc((uint32_t)(im->size / 0x4000));
+	if (slot < 0) {
+		lck_mtx_unlock(&kgsl_mtx);
+		return ENOMEM;
+	}
+	struct kbo *b = &k.bo[id];
+	b->used = b->host = true;
+	b->owner = owner;
+	b->size = im->size;
+	b->uaddr = im->addr;
+	b->gva = HOST_GPUVA + (uint64_t)slot * 0x4000;
+	b->map = current_map();
+	vm_map_reference(b->map);
+	kern_return_t kr = vm_map_wire_kernel(b->map, (vm_map_offset_t)im->addr, (vm_map_offset_t)(im->addr + im->size),
+	    VM_PROT_READ | VM_PROT_WRITE, VM_KERN_MEMORY_IOKIT, TRUE);
+	if (kr != KERN_SUCCESS) {
+		host_unmap(b, 0);
+		vm_map_deallocate(b->map);
+		bzero(b, sizeof(*b));
+		lck_mtx_unlock(&kgsl_mtx);
+		return kr == KERN_INVALID_ADDRESS ? EFAULT : ENOMEM;
+	}
+	pmap_t pm = get_task_pmap(current_task());
+	uint64_t o;
+	for (o = 0; o < im->size; o += 0x1000) {
+		uint64_t va = im->addr + o;
+		ppnum_t pn = pmap_find_phys(pm, va);
+		if (!pn || !host_pte(b->gva + o, ptoa_64(pn) + (va & PAGE_MASK & ~0xfffull))) {
+			break;
+		}
+	}
+	if (o < im->size) {
+		bo_release(b);          /* unmaps what was mapped (all slots), unwires */
+		lck_mtx_unlock(&kgsl_mtx);
+		return EFAULT;
+	}
+	gpu_tlb_flush();
+	im->id = (uint32_t)id + 1;
+	im->gpuaddr = b->gva;
+	lck_mtx_unlock(&kgsl_mtx);
+	return 0;
+}
