diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index 9cb97d5..2591a0f 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -588,10 +588,13 @@ sweet_surface_fill_result(SweetSurface *s, SweetSurfaceRef *ref, uint8_t *out)
 	for (uint32_t i = 0; i < s->planeCount; i++) {
 		uint8_t *p = out + 0x68 + i * 0x80;
 		const struct sweet_surface_plane *pl = &s->planes[i];
+		/* plane record as IOSurface.framework reads it (iOS 16; layout from HackiOS MiniIOSurface.h,
+		 * github.com/oosexgang/hackios-xnu-kernel, APSL): bytes per row at 0x10, not 0x08 (0x08 left
+		 * IOSurfaceGetBytesPerRowOfPlane() at 0 for every multi-plane surface) */
 		put32(p, 0x00, pl->width);
 		put32(p, 0x04, pl->height);
-		put32(p, 0x08, pl->bytesPerRow);
 		put32(p, 0x0c, pl->offset);
+		put32(p, 0x10, pl->bytesPerRow);
 		put32(p, 0x14, pl->size);
 		memcpy(p + 0x18, &pl->bytesPerElement, 2);
 		p[0x1a] = pl->elementWidth;
