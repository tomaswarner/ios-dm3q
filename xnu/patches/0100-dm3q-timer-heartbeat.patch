+#if defined(SWEET)
+#include <arm64/sweet_early.h>
+#include <pexpert/pexpert.h>
+
+/*
+ * DM3Q bring-up heartbeat: once a second the timer IRQ redraws
+ * "HB n=<timer irqs> pc=<interrupted pc> lr=<lr> m=<spsr mode>" in the
+ * bottom band. Counting n shows timer interrupts arrive; pc/lr show where
+ * the CPU is (idle loop vs a spin) when boot stops making progress.
+ */
+static uint64_t sweet_hb_count, sweet_hb_last;
+
+static char *
+sweet_hb_hex(char *p, const char *label, uint64_t v, int digits)
+{
+	while (*label) {
+		*p++ = *label++;
+	}
+	for (int i = digits - 1; i >= 0; i--) {
+		*p++ = "0123456789abcdef"[(v >> (4 * i)) & 0xf];
+	}
+	*p++ = ' ';
+	return p;
+}
+
+static void
+sweet_heartbeat(arm_saved_state_t *state)
+{
+	static int sweet_hb_on = -1;     /* boot-arg sweethb=1; off by default (draws over the GUI) */
+	if (sweet_hb_on < 0) {
+		int v = 0;
+		PE_parse_boot_argn("sweethb", &v, sizeof(v));
+		sweet_hb_on = v;
+	}
+	if (!sweet_hb_on) {
+		return;
+	}
+	uint64_t now = ml_get_timebase();
+	sweet_hb_count++;
+	if (now - sweet_hb_last < 19200000ULL) {     /* 1 s at 19.2 MHz */
+		return;
+	}
+	sweet_hb_last = now;
+	char buf[96], *p = buf;
+	p = sweet_hb_hex(p, "HB n=", sweet_hb_count, 8);
+	p = sweet_hb_hex(p, "pc=", get_saved_state_pc(state), 16);
+	p = sweet_hb_hex(p, "lr=", get_saved_state_lr(state), 16);
+	p = sweet_hb_hex(p, "m=", get_saved_state_cpsr(state) & 0xf, 1);
+	p = sweet_hb_hex(p, "t=", now >> 24, 6);
+	*p = 0;
+	sweet_early_status(buf);
+}
+#endif /* SWEET */
