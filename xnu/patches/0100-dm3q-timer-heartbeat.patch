+/*
+ * DM3Q bring-up: one status line in the bottom band (below the console rows,
+ * where the stage marks go), redrawn in place. Ignores early_disabled so the
+ * timer heartbeat in sleh.c stays visible after the console hand-over.
+ */
+void
+sweet_early_status(const char *s)
+{
+	const unsigned int y0 = EARLY_HEIGHT - EARLY_CELL_H;
+	for (unsigned int col = 0; col < EARLY_COLS; col++) {
+		unsigned char c = *s ? (unsigned char)*s++ : ' ';
+		const unsigned char *glyph = iso_font + c * 16;
+		for (unsigned int gy = 0; gy < 16; gy++) {
+			for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
+				volatile uint32_t *line = EARLY_FB +
+				    (y0 + gy * EARLY_SCALE + sy) * EARLY_STRIDE + col * EARLY_CELL_W;
+				for (unsigned int gx = 0; gx < 8; gx++) {
+					uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0xffffff00u : 0xff0000a0u;
+					for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
+						line[gx * EARLY_SCALE + sx] = pixel;
+					}
+				}
+			}
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
