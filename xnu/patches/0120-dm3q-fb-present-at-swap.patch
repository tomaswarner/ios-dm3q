 void
 AppleCLCD::swap(const uint8_t *rec)
 {
+	/*
+	 * Copy now, before SwapEnd returns: nothing tells CoreAnimation when the panel copy of a
+	 * surface is done, so it reuses the surface for a later frame at once; copied later (at the
+	 * vsync timer, up to 1/sweetfb_hz s after) the copy reads a frame being drawn over (GPU:
+	 * torn, mixed frames).
+	 */
+	if (fSyncPresent && !fPowerOff) {
+		timedPresent(rec);
+		if ((++sweet_fb_swap_count % 1000) == 0) {
+			IOLog("SWEET FB: %llu swaps\n", sweet_fb_swap_count);
+		}
+		return;
+	}
 	IOLockLock(fLock);
 	memcpy(fPending, rec, SWEET_FB_SWAP_REC_SIZE);
 	fDirty = true;
