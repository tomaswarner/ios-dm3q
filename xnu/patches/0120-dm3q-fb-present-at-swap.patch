+/* present() under fPresentLock, timed (log every 128 frames) */
+void
+AppleCLCD::timedPresent(const uint8_t *rec)
+{
+	IOLockLock(fPresentLock);
+	uint64_t t0 = mach_absolute_time();
+	present(rec);
+	uint64_t dt = mach_absolute_time() - t0;
+	fPresentAbs += dt;
+	if (dt > fPresentMaxAbs) {
+		fPresentMaxAbs = dt;
+	}
+	if (++fPresents % 128 == 0) {
+		uint64_t avg, max;
+		absolutetime_to_nanoseconds(fPresentAbs / 128, &avg);
+		absolutetime_to_nanoseconds(fPresentMaxAbs, &max);
+		IOLog("SWEET FB: present %u frames: mean %llu us, max %llu us (panel copy, CPU, %s)\n", fPresents,
+		    avg / 1000, max / 1000, fSyncPresent ? "at SwapEnd" : "at vsync");
+		fPresentAbs = fPresentMaxAbs = 0;
+	}
+	IOLockUnlock(fPresentLock);
+}
