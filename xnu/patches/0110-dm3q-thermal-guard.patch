+/*
+ * DM3Q (Galaxy S23 Ultra, SM8550) thermal guard: nothing else in this kernel
+ * manages temperature, and the shim (port/shim/perf.c) pins every CPU cluster
+ * at its top non-turbo EPSS level. Only the SoC's hardware limits (LMh/DCVSH,
+ * PMIC shutdown) would act otherwise.
+ *
+ * Sensors: TSENS v2 controllers (DT tsens0/1/2, "tm" regions 0xc271000,
+ * 0xc272000, 0xc273000); sensor n's status at TM + 0xa0 + 4n: bits 11:0 the
+ * last temperature in deci-Celsius (signed), bit 21 valid (Linux tsens-v2.c).
+ * DT thermal zones: tsens0 1-4 cpuss, 5-15 cpu-1-*; tsens1 1-3 cpu-0-*;
+ * tsens2 1-8 gpuss.
+ * CPU frequency: EPSS domains at 0x17d91000/2000/3000 (shim/perf.c): LUT at
+ * +0x100 (f = 19.2 MHz * bits 7:0, ends when the frequency repeats), the
+ * requested perf index at +0x320.
+ *
+ * Every second: hottest CPU/GPU sensor T. T >= 90 C: every domain to its
+ * slowest row; T >= 80 C: three rows down; T >= 75 C: one row down; T <= 65 C
+ * (every 3 s): one row up, never above the shim's level. Start two rows below
+ * the shim's level. A line every 30 s and on every change ("SWEET THERM").
+ * Boot-arg sweetthermal=0: off; sweetthermal=2: monitor only (no throttling).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+void sweet_thermal_start(void);
+
+#define TSENS_PA        0x0c270000u     /* tm regions at +0x1000, +0x2000, +0x3000 */
+#define EPSS_PA         0x17d90000u     /* domains at +0x1000, +0x2000, +0x3000 */
+#define TM_SN_STATUS    0xa0u
+#define EPSS_LUT(i)     (0x100u + 4u * (i))
+#define EPSS_DOMAIN     0x020u
+#define EPSS_PERF       0x320u
+#define NDOM            3
+#define TH_NONE         (-100000)       /* no valid reading */
+
+static struct {
+	vm_offset_t tsens, epss;
+	unsigned n[NDOM], cap[NDOM], level[NDOM];
+	bool started, throttle;
+} th;
+
+static uint32_t
+rd(vm_offset_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static void
+wr(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+}
+
+static int th_sleep_chan;
+
+static void
+th_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&th_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* deci-Celsius of controller c's sensor s, or TH_NONE when not valid */
+static int
+sensor(unsigned c, unsigned s)
+{
+	uint32_t v = rd(th.tsens + 0x1000u * (c + 1) + TM_SN_STATUS + 4u * s);
+	if (!(v & (1u << 21))) {
+		return TH_NONE;
+	}
+	return (int)(v << 20) >> 20;    /* 12-bit two's complement */
+}
+
+static int
+hottest(unsigned c, unsigned first, unsigned last)
+{
+	int t = TH_NONE;
+	for (unsigned s = first; s <= last; s++) {
+		int v = sensor(c, s);
+		if (v > t) {
+			t = v;
+		}
+	}
+	return t;
+}
+
+static unsigned
+mhz(uint32_t lut)
+{
+	return (lut & 0xffu) * 192u / 10u;
+}
+
+static unsigned
+dom_mhz(unsigned d, unsigned idx)
+{
+	return mhz(rd(th.epss + 0x1000u * (d + 1) + EPSS_LUT(idx)));
+}
+
+static void
+set_level(unsigned d, unsigned idx)
+{
+	if (idx > th.cap[d]) {
+		idx = th.cap[d];
+	}
+	if (idx == th.level[d]) {
+		return;
+	}
+	th.level[d] = idx;
+	if (th.throttle) {
+		wr(th.epss + 0x1000u * (d + 1) + EPSS_PERF, idx);
+	}
+}
+
+static void
+epss_init(void)
+{
+	for (unsigned d = 0; d < NDOM; d++) {
+		vm_offset_t b = th.epss + 0x1000u * (d + 1);
+		unsigned prev = 0, n = 0;
+		for (unsigned i = 0; i < 40; i++) {
+			unsigned f = mhz(rd(b + EPSS_LUT(i)));
+			if (!f || f == prev) {
+				break;
+			}
+			n = i + 1;
+			prev = f;
+		}
+		th.n[d] = n;
+		th.cap[d] = rd(b + EPSS_PERF) & 0xffu;
+		if (n && th.cap[d] >= n) {
+			th.cap[d] = n - 1;
+		}
+		th.level[d] = th.cap[d];
+		printf("SWEET THERM: cpu domain %u: %u rows, shim level %u = %u MHz (now %u MHz)\n", d, n,
+		    th.cap[d], n ? dom_mhz(d, th.cap[d]) : 0, mhz(rd(b + EPSS_DOMAIN)));
+		set_level(d, th.cap[d] >= 2 ? th.cap[d] - 2 : 0);
+	}
+}
+
+static void
+report(const char *why, int cpu, int gpu)
+{
+	printf("SWEET THERM: %s cpu %d.%d C gpu %d.%d C, cpu MHz %u/%u/%u%s\n", why,
+	    cpu / 10, (cpu < 0 ? -cpu : cpu) % 10, gpu / 10, (gpu < 0 ? -gpu : gpu) % 10,
+	    th.n[0] ? dom_mhz(0, th.level[0]) : 0, th.n[1] ? dom_mhz(1, th.level[1]) : 0,
+	    th.n[2] ? dom_mhz(2, th.level[2]) : 0, th.throttle ? "" : " (monitor only)");
+}
+
+static void
+thermal_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	th.tsens = ml_io_map(TSENS_PA, 0x4000);
+	th.epss = ml_io_map(EPSS_PA, 0x4000);
+	if (!th.tsens || !th.epss) {
+		printf("SWEET THERM: MMIO mapping failed\n");
+		goto out;
+	}
+	epss_init();
+	for (unsigned tick = 0;; tick++) {
+		int cpu = hottest(0, 1, 15), c1 = hottest(1, 1, 3), gpu = hottest(2, 1, 8);
+		if (c1 > cpu) {
+			cpu = c1;
+		}
+		int t = cpu > gpu ? cpu : gpu;
+		const char *why = NULL;
+		for (unsigned d = 0; d < NDOM; d++) {
+			unsigned l = th.level[d], want = l;
+			if (t == TH_NONE) {
+				want = l;
+			} else if (t >= 900) {
+				want = 0;
+			} else if (t >= 800) {
+				want = l >= 3 ? l - 3 : 0;
+			} else if (t >= 750) {
+				want = l >= 1 ? l - 1 : 0;
+			} else if (t <= 650 && tick % 3 == 0) {
+				want = l + 1;
+			}
+			if (want != l) {
+				unsigned before = th.level[d];
+				set_level(d, want);
+				if (th.level[d] != before) {
+					why = th.level[d] < before ? "throttle" : "relax";
+				}
+			}
+		}
+		if (why != NULL || tick % 30 == 0) {
+			report(why != NULL ? why : "status", cpu, gpu);
+		}
+		th_sleep(1000);
+	}
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_thermal_start(void)
+{
+	int mode = 1;
+	thread_t thread;
+	if (th.started) {
+		return;
+	}
+	th.started = true;
+	(void)PE_parse_boot_argn("sweetthermal", &mode, sizeof(mode));
+	if (mode == 0) {
+		printf("SWEET THERM: off (sweetthermal=0)\n");
+		return;
+	}
+	th.throttle = mode != 2;
+	kern_return_t kr = kernel_thread_start(thermal_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET THERM: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
