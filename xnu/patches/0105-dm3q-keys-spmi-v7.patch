+		bool gok = keys_read(keys_gpio_apid, keys_dm3q ? DM3Q_GPIO_RT : KEYS_GPIO_RT, &gpio);
 		int now[3] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u)};
+		if (keys_dm3q) {
+			now[0] = !!(pon & 0x80u);       /* KPDPWR_N (GEN3) */
