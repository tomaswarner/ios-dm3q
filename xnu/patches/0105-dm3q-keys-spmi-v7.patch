 }
 
+/* DM3Q: v7 bus 0, read-only like the sweet path (EXT_READL on an observer channel) */
+static void
+dm3q_keys_start(void)
+{
+	thread_t thread;
+	keys_core = ml_io_map(DM3Q_CORE_PA, 0x3000);
+	keys_cnfg = ml_io_map(DM3Q_CNFG_PA, 0x1000);
+	keys_obs = ml_io_map(DM3Q_OBS_PA, 0x8000);   /* EE 0: 1024 channels * 0x20 */
+	if (!keys_core || !keys_cnfg || !keys_obs) {
+		printf("SWEET KEYS: dm3q MMIO mapping failed\n");
+		return;
+	}
+	keys_version = keys_rd(keys_core, 0);
+	uint32_t count = keys_rd(keys_core, 4) & 0x7ffu;
+	if (keys_version < 0x70000000u || count == 0 || count > 1024) {
+		printf("SWEET KEYS: dm3q unsupported arbiter version=%#x apids=%u\n", keys_version, count);
+		return;
+	}
+	if (count > 0x400u) {
+		count = 0x400u;                 /* the cnfg map covers 0x1000 / 4 owners */
+	}
+	keys_pon_apid = keys_find_apid(0x013, count);   /* SID 0 periph 0x13 */
+	keys_gpio_apid = keys_find_apid(0x18d, count);  /* SID 1 periph 0x8d */
+	uint8_t pon = 0, gpio = 0, st1 = 0, mode = 0, en = 0;
+	bool pok = keys_read(keys_pon_apid, DM3Q_PON_RT, &pon);
+	bool gok = keys_read(keys_gpio_apid, DM3Q_GPIO_RT, &gpio);
+	bool sok = keys_read(keys_gpio_apid, 0x8d08, &st1);
+	bool mok = keys_read(keys_gpio_apid, 0x8d40, &mode);
+	bool eok = keys_read(keys_gpio_apid, 0x8d46, &en);
+	printf("SWEET KEYS: dm3q arb=%#x apids=%u pon-apid=%u gpio6-apid=%u pon=%#x/%d rt=%#x/%d st1=%#x/%d mode=%#x/%d en=%#x/%d\n",
+	    keys_version, count, keys_pon_apid, keys_gpio_apid, pon, pok, gpio, gok, st1, sok, mode, mok, en, eok);
+	if (!pok && !gok) {
+		printf("SWEET KEYS: dm3q no readable keys; polling retained for recovery\n");
+	}
+	kern_return_t kr = kernel_thread_start(keys_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET KEYS: kernel_thread_start failed %d\n", kr);
+	}
+}
+
 void
 sweet_keys_init(void)
 {
@@ -134,6 +194,11 @@
 	(void)PE_parse_boot_argn("sweetkeys", &enabled, sizeof(enabled));
 	if (!enabled) {
 		printf("SWEET KEYS: disabled (sweetkeys=0)\n");
+		return;
+	}
+	keys_dm3q = enabled == 2;
+	if (keys_dm3q) {
+		dm3q_keys_start();
 		return;
 	}
 	keys_core = ml_io_map(KEYS_CORE_PA, 0x2000);
