+/*
+ * DM3Q (sweetkeys=2): SM8550 SPMI arbiter v7, bus 0 (spmi@c42d000, EE 0).
+ * APID map at core + 0x2000 + 4n, owner at cnfg + 4n, observer channel
+ * 0x20 * apid (Linux spmi-pmic-arb v7). Keys: PMK8550 (SID 0) pon_hlos 0x1300
+ * INT_RT_STS 0x1310 bit 7 KPDPWR, bit 6 RESIN (vol-) (pm8941-pwrkey GEN3);
+ * vol+ = PM8550 (SID 1) GPIO6 (periph 0x8d), pull-up, active low.
+ */
+#define DM3Q_CORE_PA     0x0c400000u
+#define DM3Q_OBS_PA      0x0c440000u
+#define DM3Q_CNFG_PA     0x0c42d000u
+#define DM3Q_PON_RT      0x1310u
+#define DM3Q_GPIO_RT     0x8d10u
+static bool keys_dm3q;
+
 static vm_offset_t keys_core, keys_obs, keys_cnfg;
 static uint16_t keys_pon_apid = KEYS_NO_APID, keys_gpio_apid = KEYS_NO_APID;
 static uint32_t keys_version, keys_last_status;
@@ -44,11 +58,11 @@
 {
 	uint16_t found = KEYS_NO_APID;
 	for (uint32_t i = 0; i < count; ++i) {
-		uint32_t map = keys_rd(keys_core, 0x900u + 4u * i);
+		uint32_t map = keys_rd(keys_core, (keys_dm3q ? 0x2000u : 0x900u) + 4u * i);
 		if (map == 0 || ((map >> 8) & 0xfffu) != ppid) {
 			continue;
 		}
-		uint32_t owner = keys_rd(keys_cnfg, 0x700u + 4u * i) & 7u;
+		uint32_t owner = keys_rd(keys_cnfg, (keys_dm3q ? 0u : 0x700u) + 4u * i) & 7u;
 		if (found == KEYS_NO_APID || owner == 0) {
 			found = (uint16_t)i;
 		}
@@ -62,7 +76,7 @@
 	if (apid == KEYS_NO_APID) {
 		return false;
 	}
-	uint32_t off = 0x80u * apid; /* obs + EE(0)*0x10000 */
+	uint32_t off = (keys_dm3q ? 0x20u : 0x80u) * apid; /* obs + EE(0) * (v7 0x8000, v5 0x10000) */
 	uint32_t cmd = (1u << 27) | ((uint32_t)(addr & 0xffu) << 4);
 	__asm__ volatile("dmb oshst" ::: "memory");
 	*(volatile uint32_t *)(keys_obs + off) = cmd; /* EXT_READL, one byte */
@@ -99,9 +113,13 @@
 	(void)result;
