diff -ruN a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp	2026-10-21 00:07:22
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp	2026-10-21 00:07:22
@@ -170,7 +170,13 @@
 	PE_parse_boot_argn("sweetfb_native", &native, sizeof(native));
 	fLogicalW = fWidth;
 	fLogicalH = fHeight;
