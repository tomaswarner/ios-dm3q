+/*
+ * DM3Q: the host does not see the phone after boot until the cable is replugged (the bootloader's
+ * session ends without a disconnect the host notices). Until the host resets the bus, every 4 s:
+ * a soft disconnect (RUN_STOP 0, the D+ pull-up off) for 1 s and connect again, what a replug does.
+ */
+extern kern_return_t thread_terminate(thread_t);
+static int ud_reconnect_chan;
+
+static void
+ud_reconnect_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	for (int tries = 0; tries < 6 && !sweet_usb_seen_reset; tries++) {
+		uint64_t deadline;
+		clock_interval_to_deadline(4000, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&ud_reconnect_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+		if (sweet_usb_seen_reset) {
+			break;
+		}
+		printf("SWEET USB: no bus reset yet: soft disconnect/connect (try %d)\n", tries + 1);
+		dwc_wr(DCTL, dwc_rd(DCTL) & ~DCTL_RUN_STOP);
+		delay(1000000);
+		dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
