+/*
+ * DM3Q Metal device nub (boot-arg sweetmetal=1).
+ *
+ * Metal's _MTLRegisterDevices (iOS 16.7) walks IOServiceMatching("IOAcceleratorES") and, per
+ * service, loads /System/Library/Extensions/<MetalPluginName>.bundle, takes the class named
+ * MetalPluginClassName (a subclass of _MTLDevice) and calls initWithAcceleratorPort:. Our
+ * SweetMetal.bundle (Metal over metal2vulkan and Vulkan, CPU lavapipe for now) needs nothing
+ * else from the kernel, so this service only publishes those two properties; it has no user
+ * client (IOServiceOpen fails, which EAGL treats as no accelerator).
+ *
+ * Without the boot-arg start() fails and the registry has no IOAcceleratorES, as before:
+ * CoreAnimation and CoreImage keep their non-Metal paths.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <pexpert/pexpert.h>
+
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+bool
+IOAcceleratorES::start(IOService *provider)
+{
+	uint32_t on = 0;
+	char plugin[64] = "SweetMetal";
+	char cls[64] = "SweetMTLDevice";
+
+	if (!PE_parse_boot_argn("sweetmetal", &on, sizeof(on)) || on == 0) {
+		return false;
+	}
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	/* sweetmetal_plugin= / sweetmetal_class= override the bundle and class (tests). */
+	PE_parse_boot_argn("sweetmetal_plugin", plugin, sizeof(plugin));
+	PE_parse_boot_argn("sweetmetal_class", cls, sizeof(cls));
+	setProperty("MetalPluginName", plugin);
+	setProperty("MetalPluginClassName", cls);
+	setProperty("MetalStatisticsName", plugin);
+	registerService();
+	IOLog("SWEET METAL: IOAcceleratorES registered (MetalPluginName %s, MetalPluginClassName %s)\n",
+	    plugin, cls);
+	return true;
+}
+#endif /* SWEET */
