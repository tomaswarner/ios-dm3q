 /// The host pages an image is bound to, as its first move notes them (`texture/first_move.rs`).
+/// Whether textures may alias the caller's host pages (environment `M2V_ALIAS_HOST_PAGES` set):
+/// for a driver whose layout transitions never touch an image's memory (lavapipe), where the
+/// window server renders straight into its IOSurfaces instead of through a shadow it copies the
+/// whole surface into for every pass. Off by default (the refusal above is Metal's contract).
+fn alias_host_pages() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("M2V_ALIAS_HOST_PAGES").is_some())
+}
