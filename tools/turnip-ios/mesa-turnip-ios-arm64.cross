# meson cross file: Mesa Turnip (freedreno KGSL) for iOS 16 arm64; = mesa-ios-arm64.cross + compat include dir
[binaries]
c = ['xcrun', '--sdk', 'iphoneos', 'clang']
cpp = ['xcrun', '--sdk', 'iphoneos', 'clang++']
objc = ['xcrun', '--sdk', 'iphoneos', 'clang']
ar = ['xcrun', '--sdk', 'iphoneos', 'ar']
strip = ['xcrun', '--sdk', 'iphoneos', 'strip']
cmake = 'cmake'
llvm-config = '/Users/tomaswarner/hios/port/tools/llvm-config-ios.py'
pkg-config = 'false'

[built-in options]
c_args = ['-I/Users/tomaswarner/hios/port/tools/turnip-ios/include', '-arch', 'arm64', '-miphoneos-version-min=16.0', '-isysroot', '/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS27.1.sdk']
cpp_args = ['-I/Users/tomaswarner/hios/port/tools/turnip-ios/include', '-arch', 'arm64', '-miphoneos-version-min=16.0', '-isysroot', '/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS27.1.sdk']
c_link_args = ['-lz', '-arch', 'arm64', '-miphoneos-version-min=16.0', '-isysroot', '/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS27.1.sdk']
cpp_link_args = ['-lz', '-arch', 'arm64', '-miphoneos-version-min=16.0', '-isysroot', '/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS27.1.sdk']

[properties]
needs_exe_wrapper = true
cmake_prefix_path = ['/Users/tomaswarner/hios/third_party/llvm-ios']

[host_machine]
system = 'darwin'
subsystem = 'ios'
kernel = 'xnu'
cpu_family = 'aarch64'
cpu = 'arm64'
endian = 'little'
